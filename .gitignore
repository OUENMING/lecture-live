# ── 密钥 / 个人配置（绝不入库）─────────────────────────
.deepseek_key
.course
# 通用密钥形态：仓库是公开的，误放一个文件就会永久留在 git 历史里
.env
.env.*
*.key
*.pem
id_rsa*
credentials*

# ── 本地术语数据（含学校课号，按需自备）──────────────────
# glossary.txt 由 glossary.example.txt 复制而来
glossary.txt
glossary/
term_notes.json
term_notes_auto.json
term_notes*.bak

# ── 课堂记录（个人内容，不入库）────────────────────────
sessions/

# ── Python ───────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── macOS ────────────────────────────────────────────
.DS_Store

# 窗口尺寸记忆(个人偏好, 不入库)
.window

# 更新提示的"已提示过"标记(每台机器自己的状态, 不入库)
.update-notice

# 更新说明框的"已看过"标记(每台机器自己的状态)
.update-seen

# 用户在卡片上勾了「以后不再提示」才会出现(每台机器自己的状态)
.update-skip

# 构建产物：双击启动用的 .app（由 make-app.sh 生成，不入库）
ClassLive.app/
.build/
