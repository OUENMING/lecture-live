# ── 密钥 / 个人配置（绝不入库）─────────────────────────
.deepseek_key
.course
# 通用密钥形态：仓库是公开的，误放一个文件就会永久留在 git 历史里
.env
.env.*
# ⚠️ 但**模板要放行**（2026-09-28 审查指出）：`.env.*` 会连带把 `.env.example`
#    这类要给人复制的样板也忽略掉，而且整个文件没有一条 `!` 规则 ——
#    将来真加了模板会**静默不入库**（`git status` 里根本不出现，很难察觉）。
!.env.example
!.env.sample
!.env.template
*.key
*.pem
id_rsa*
credentials*
# ⚠️ 补四种**最常见的密钥容器**（2026-09-28 审查指出）：这个项目自己就在
#    构建 macOS `.app`，而签名证书导出就是 `.p12` —— 误提交会永久留在 git 历史里。
*.p12
*.pfx
*.jks
*.keystore

# ── 本地术语数据（含学校课号，按需自备）──────────────────
# glossary.txt 由 glossary.example.txt 复制而来
glossary.txt
glossary/
term_notes.json
term_notes_auto.json
term_notes*.bak

# ── 课堂记录（个人内容，不入库）────────────────────────
sessions/

# ── Python ───────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── macOS ────────────────────────────────────────────
.DS_Store

# 窗口尺寸记忆(个人偏好, 不入库)
.window

# 更新提示的"已提示过"标记(每台机器自己的状态, 不入库)
.update-notice

# 更新说明框的"已看过"标记(每台机器自己的状态)
.update-seen

# 用户在卡片上勾了「以后不再提示」才会出现(每台机器自己的状态)
.update-skip

# 构建产物：双击启动用的 .app（由 make-app.sh 生成，不入库）
ClassLive.app/
# make-app.sh 构建期间的备份（构建成功会自己删；失败时用来恢复旧版）
ClassLive.app.bak/
.build/

# 图标：`tools/make_icon.py` 是**生成器**，其余全是它的产物。
# ⚠️ 产物一律不入库 —— make-app.sh 每次构建都无条件重跑生成器，
#    入库的话每次构建都会把工作区弄脏（然后就会习惯性忽略 git status）。
#    1024 那张主图例外：它是给人看的设计稿（README / 沟通用）。
assets/icon/ClassLive.icns
assets/icon/ClassLive.iconset/

