{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"vendor": "node scripts/vendor-fetch.mjs",
		"prebuild": "npm run vendor",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:audio-asr": "node tests/audio-asr/run.mjs",
		"test:devices": "node --import tsx --test tests/audio/*.test.ts tests/live/wake.test.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:core-drift": "python3 -I scripts/sync-core.py --check",
		"sync:core": "python3 -I scripts/sync-core.py --write",
		"test:core": "node --import tsx --test tests/core/*.test.ts",
		"test:session": "node --import tsx --test tests/session/*.test.ts",
		"test:store": "node --import tsx --test tests/store/*.test.ts",
		"test:api": "node --import tsx --test tests/api/*.test.ts",
		"test:live": "node --import tsx --test tests/live/*.test.ts",
		"test:after": "node --import tsx --test tests/after/*.test.ts",
		"test:terms": "node --import tsx --test tests/terms/*.test.ts",
		"test:translate": "node tests/translate/run.mjs",
		"test:prep": "node --import tsx --test tests/prep/*.test.ts"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.74.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"cn": "^0.5.2",
		"fake-indexeddb": "^6.2.8",
		"pyodide": "314.0.8",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tsx": "4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
